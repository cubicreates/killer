{
  "manifest_version": 3,
  "name": "Silent Fullscreen Interceptor",
  "version": "1.0.0",
  "description": "Silently mocks the Fullscreen API so pages believe they are in fullscreen while remaining windowed.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
